Options -Indexes
RewriteEngine On

# Redirige la racine / vers public/index.php directement
RewriteRule ^$ public/index.php [QSA,L]

# Redirige tout le reste vers public/index.php
# sans les conditions !-f et !-d qui bloquaient la réécriture
# quand le dossier racine lui-même était demandé
RewriteCond %{REQUEST_URI} !^/cisco-pk/public/
RewriteRule ^(.*)$ public/index.php [QSA,L]
